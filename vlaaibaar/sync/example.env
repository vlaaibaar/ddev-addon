#ddev-generated
# Template for .ddev/vlaaibaar/sync/<environment>.env
# Copy to e.g. staging.env and fill in. Commit it: these settings are shared by the team.
# Add-on updates never overwrite the copies.

# Host or IP of the server, without a user. Each developer sets their own SSH user
# in <environment>.local.env (gitignored), see example.local.env.
SSH_HOST="CHANGE_ME"

# Project root on the server (the directory containing the `craft` executable).
# Relative paths (no leading slash) start from the SSH user's home folder.
REMOTE_PATH="public_html"

# Uploads directory on the server (point this at the shared dir when using release/symlink deploys)
REMOTE_UPLOADS="public_html/web/uploads"

# Allow `ddev push` to this environment (overwrites its database and adds uploads)
ALLOW_PUSH=false
