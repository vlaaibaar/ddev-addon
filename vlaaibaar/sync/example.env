#ddev-generated
# Template for .ddev/vlaaibaar/sync/<environment>.env
# Copy to e.g. staging.env and fill in. Commit it: these settings are shared by the team.
# Add-on updates never overwrite the copies.

# Host or IP of the server, without a user.
SSH_HOST="CHANGE_ME"

# Each developer sets their own SSH user in <environment>.local.env (gitignored), see
# example.local.env. Only set a shared user here if the team really shares one.
# SSH_USER="CHANGE_ME"

# Project root on the server (the directory containing the `craft` executable).
# Relative paths (no leading slash) start from the SSH user's home folder. An absolute path
# works for every user, e.g. /home/<server>.cloudwaysapps.com/<app>/public_html
REMOTE_PATH="public_html"

# Uploads directory on the server (point this at the shared dir when using release/symlink deploys)
REMOTE_UPLOADS="public_html/web/uploads"

# PHP binary on the server. Defaults to php<version> for the php_version in .ddev/config.yaml
# (e.g. php8.3), since the SSH user's default `php` can be another version.
# REMOTE_PHP="php8.3"

# Allow `ddev push` to this environment (overwrites its database and adds uploads)
ALLOW_PUSH=false
